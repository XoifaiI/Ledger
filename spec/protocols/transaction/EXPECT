# TxAbs: the design at the level of landings, for the proofs of S1, S4 and S5 (design rule 13).
TxAbs.cfg MCTxAbs expect=pass timeout=7200 why=TxAbs keeps S1 S4 S5 NonNeg and IndInv on every reachable state
ApaTxAbs.tla abs-init-ConstInit expect=pass timeout=3600 tool=apalache args=--cinit=ConstInit --init=Init --next=Next --inv=IndInv --length=0 why=initiation: Init implies IndInv
ApaTxAbs.tla abs-ind-ConstInit expect=pass timeout=14400 tool=apalache args=--cinit=ConstInit --init=IndInit --next=Next --inv=IndInv --length=1 why=consecution: IndInv is inductive, so S1 S4 S5 NonNeg hold in every state (two keys, three uses, two attempts)
ApaTxAbs.tla abs-init-ConstBig expect=pass timeout=3600 tool=apalache args=--cinit=ConstBig --init=Init --next=Next --inv=IndInv --length=0 why=initiation on three keys, a three-leg use, three attempts
ApaTxAbs.tla abs-ind-ConstBig expect=pass timeout=14400 tool=apalache args=--cinit=ConstBig --init=IndInit --next=Next --inv=IndInv --length=1 why=consecution on three keys, a three-leg use, three attempts
ApaTxAbs.tla abs-ind-CtlAttempt expect=violate:IndInv timeout=3600 tool=apalache args=--cinit=CtlAttempt --init=IndInit --next=Next --inv=IndInv --length=1 why=control: a Tent of attempt a before attempt a-1 was fenced; the induction needs the guard
